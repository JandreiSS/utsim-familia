        "Queue": "fila",
        "Processor": "estação",
        "Combiner": "montagem",
        "Separator": "comanda",
        "Sink": "saída",
        "Transporter": "funcionário",
        "Dispatcher": "equipe",
        "operador": "funcionário",
        "operadores": "funcionários",
        // Medidas.
        "time_in_system": "tempo do pedido",
        "process_time": "tempo de preparo",
        "content": "pedidos em preparo",
        "throughput": "pedidos por hora",
        "utilization": "ocupação",
        // Estados.
        "idle": "parada",
        "processing": "preparando",
        "setup": "em preparação",
        "blocked": "bloqueada",
        "down": "quebrada",
        "waiting_operator": "esperando o funcionário",
        "off_shift": "fechada",
