// Glossário do pacote "Estatística e qualidade na fábrica". Textos próprios do UTSim.
Glossario(termos: [
    (id: "replicacao", nome: "Replicação",
     texto: "Uma rodada completa do modelo com outra sequência de números aleatórios. Cada replicação dá um resultado diferente, e a média de várias estima o desempenho do sistema.",
     manual: "experimentos-e-otimizacao.md"),
    (id: "intervalo_de_confianca", nome: "Intervalo de confiança",
     texto: "Faixa em torno da média que, com a confiança escolhida (em geral 95 %), contém o valor verdadeiro. A meia largura é a média mais ou menos o quanto. Ela cai com a raiz do número de replicações.",
     manual: "estatistica.md"),
    (id: "numeros_aleatorios_comuns", nome: "Números aleatórios comuns",
     texto: "Rodar duas alternativas com as mesmas sequências de números aleatórios, para que as duas enfrentem os mesmos imprevistos. A diferença entre elas fica com menos ruído e pede menos replicações.",
     manual: "experimentos-e-otimizacao.md"),
    (id: "teste_t_pareado", nome: "Teste t pareado",
     texto: "Teste da média das diferenças entre pares de resultados, como A e B na mesma replicação. Se o intervalo da diferença não contém o zero, a diferença é significativa.",
     manual: "estatistica.md"),
    (id: "carta_de_controle", nome: "Carta de controle",
     texto: "Gráfico da medida ao longo do tempo com centro e limites calculados de um período estável. Na carta X̄-R, cada ponto é a média ou a amplitude de um subgrupo de peças feitas juntas.",
     manual: "qualidade.md"),
    (id: "capacidade_do_processo", nome: "Capacidade do processo",
     texto: "Quanto o processo cabe na especificação. O Cpk usa o desvio dentro dos subgrupos (a amplitude média dividida por d2) e mostra o potencial do processo estável. O Ppk usa o desvio total.",
     manual: "qualidade.md"),
    (id: "msa", nome: "Análise do sistema de medição (R&R)",
     texto: "Estudo que separa a variação do instrumento (repetibilidade) e dos operadores (reprodutibilidade) da variação entre as peças. Abaixo de 10 % de R&R o sistema é aceitável, de 10 % a 30 % é marginal e acima de 30 % não serve.",
     manual: "qualidade.md"),
    (id: "estratificacao", nome: "Estratificação",
     texto: "Separação dos dados por máquina, turno, operador ou lote para achar onde a variação ou o deslocamento está.",
     manual: "estatistica.md"),
])
