// Usinagem que gera trinca, seguida de lavadora, estufa a gás e cabine de pintura com tinta. Dois
// postos de inspeção começam desligados: um logo depois da usinagem e um antes da expedição.
// Peça que vira refugo no fim já levou água quente, gás e tinta: é a mochila de impacto da
// peça. Tempos em minutos; fatores didáticos.
Model(
    name: "A mochila da peça",
    description: "Defeito na usinagem, inspeção cedo ou no fim, energia e tinta gastas no refugo",
    run: (stop_time: 960.0, warmup: 60.0, seed: 53, replications: 5),
    packs: ["qualidade"],
    objects: [
        (name: "chegada", kind: Source(interarrival: Exp(mean: 5.0)), position: (0.0, 0.0, 0.0)),
        (name: "usinagem", kind: Processor(process: Triangular(min: 2.5, mode: 3.0, max: 3.5)),
         position: (4.0, 0.0, 0.0),
         quality: Some((defects: [(name: "trinca", probability: 0.12)])),
         environment: Some((stage: Some("usinagem"), power: (producing: 10.0, waiting: 3.0)))),
        (name: "fila1", kind: Queue(), position: (7.0, 0.0, 0.0)),
        (name: "insp_cedo", kind: Processor(process: Const(0.3)), output: ByLabel("inspecao"),
         position: (10.0, 0.0, 0.0),
         inspection: Some((every: 1000000, detect: 0.85, on_reject: Scrap))),
        (name: "lavadora", kind: Processor(process: Const(2.0)), position: (13.0, 0.0, 0.0),
         environment: Some((stage: Some("pré-tratamento"), power: (producing: 15.0, waiting: 4.0),
            flows: [(flow: "agua", amount: 0.02, driver: Item)]))),
        (name: "fila2", kind: Queue(), position: (16.0, 0.0, 0.0)),
        (name: "estufa", kind: Processor(process: Const(3.0)), position: (19.0, 0.0, 0.0),
         environment: Some((stage: Some("cura"), power: (producing: 2.0, waiting: 1.0),
            flows: [(flow: "gas", amount: 0.3, driver: Item)]))),
        (name: "fila3", kind: Queue(), position: (22.0, 0.0, 0.0)),
        (name: "cabine", kind: Processor(process: Const(3.0)), position: (25.0, 0.0, 0.0),
         environment: Some((stage: Some("pintura"), power: (producing: 8.0, waiting: 3.0),
            flows: [(flow: "tinta", amount: 0.2, driver: Item)]))),
        (name: "fila4", kind: Queue(), position: (28.0, 0.0, 0.0)),
        (name: "insp_final", kind: Processor(process: Const(0.5)), output: ByLabel("inspecao"),
         position: (31.0, 0.0, 0.0),
         inspection: Some((every: 1000000, detect: 0.95, on_reject: Scrap))),
        (name: "cliente", kind: Sink, sink_role: Some(Customer), position: (35.0, 0.0, 0.0)),
        (name: "refugo", kind: Sink, sink_role: Some(Scrap), position: (35.0, -4.0, 0.0)),
    ],
    connections: [
        ("chegada", "usinagem"), ("usinagem", "fila1"), ("fila1", "insp_cedo"),
        ("insp_cedo", "lavadora"), ("insp_cedo", "refugo"),
        ("lavadora", "fila2"), ("fila2", "estufa"), ("estufa", "fila3"), ("fila3", "cabine"),
        ("cabine", "fila4"), ("fila4", "insp_final"), ("insp_final", "cliente"), ("insp_final", "refugo"),
    ],
    environment: Some((
        clock: (start: "06:00", time_unit: Minute),
        flows: [(name: "eletricidade", kind: Energy, unit: "kWh", direction: In),
                (name: "gas", kind: Fuel, unit: "m3", direction: In),
                (name: "tinta", kind: Material, unit: "kg", direction: In),
                (name: "agua", kind: Water, unit: "m3", direction: In)],
        factors: [(flow: "eletricidade", scope: 2, kg_co2e: Some(0.09),
                   source: "Fator didático do pacote Fábrica verde (não é oficial)", didactic: true),
                  (flow: "gas", scope: 1, kg_co2e: Some(2.0),
                   source: "Fator didático do pacote Fábrica verde (não é oficial)", didactic: true),
                  (flow: "tinta", scope: 3, kg_co2e: Some(3.0),
                   source: "Fator didático do pacote Fábrica verde (não é oficial)", didactic: true),
                  (flow: "agua", scope: 3, kg_co2e: Some(0.3),
                   source: "Fator didático do pacote Fábrica verde (não é oficial)", didactic: true)],
    )),
)
