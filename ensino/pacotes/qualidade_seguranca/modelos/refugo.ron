// Linha de torneamento com dois postos de inspeção que começam desligados. O defeito nasce no
// torno logo depois do setup (as primeiras peças de cada ciclo de 50 têm risco bem maior) e só
// o cliente o vê. Tempos em minutos. Veja docs/formato_qualidade_seguranca.md.
Model(
    name: "Refugo escondido",
    description: "Defeito de setup, dois postos de inspeção opcionais, refugo e cliente",
    run: (stop_time: 4800.0, warmup: 240.0, seed: 31, replications: 10),
    packs: ["qualidade"],
    objects: [
        (name: "chegada", kind: Source(interarrival: Exp(mean: 2.0)), position: (0.0, 0.0, 0.0)),
        (name: "torno", kind: Processor(process: Triangular(min: 1.2, mode: 1.5, max: 2.0)),
         position: (4.0, 0.0, 0.0),
         quality: Some((
            defects: [
                (name: "trinca", probability: 0.04, factors: [Cycle(every: 50, first: 5, times: 5.0)]),
            ],
         ))),
        (name: "fila1", kind: Queue(), position: (7.0, 0.0, 0.0)),
        (name: "insp_processo", kind: Processor(process: Const(0.3)), output: ByLabel("inspecao"),
         position: (10.0, 0.0, 0.0),
         inspection: Some((every: 1000000, detect: 0.7, on_reject: Scrap, cost: Some(0.2)))),
        (name: "fila2", kind: Queue(), position: (13.0, 0.0, 0.0)),
        (name: "insp_final", kind: Processor(process: Const(0.5)), output: ByLabel("inspecao"),
         position: (16.0, 0.0, 0.0),
         inspection: Some((every: 1000000, detect: 0.95, on_reject: Scrap, cost: Some(0.6)))),
        (name: "cliente", kind: Sink, sink_role: Some(Customer), position: (20.0, 0.0, 0.0)),
        (name: "refugo", kind: Sink, sink_role: Some(Scrap), position: (20.0, -4.0, 0.0)),
    ],
    connections: [
        ("chegada", "torno"), ("torno", "fila1"), ("fila1", "insp_processo"),
        ("insp_processo", "fila2"), ("insp_processo", "refugo"),
        ("fila2", "insp_final"), ("insp_final", "cliente"), ("insp_final", "refugo"),
    ],
)
