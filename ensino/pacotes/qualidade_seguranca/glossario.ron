// Glossário do pacote de qualidade e segurança do trabalho. Textos próprios do UTSim.
Glossario(termos: [
    (id: "defeito", nome: "Defeito",
     texto: "Peça que não atende ao que o cliente espera. No modelo, cada tipo de defeito tem uma probabilidade por peça, que pode subir em momentos conhecidos, como logo depois de um setup.",
     manual: "defeitos-e-inspecao.md"),
    (id: "escape", nome: "Escape",
     texto: "Peça defeituosa que passou por todas as barreiras e chegou ao cliente. O escape é a fração delas entre as peças entregues. Quanto mais tarde o defeito é visto, mais caro ele sai.",
     manual: "defeitos-e-inspecao.md"),
    (id: "inspecao", nome: "Inspeção",
     texto: "Posto que olha ou mede as peças e decide se passam, voltam para conserto ou viram refugo. Pode olhar todas as peças ou só uma a cada n (amostragem). Inspecionar custa tempo, dinheiro e ocupa o fluxo.",
     manual: "defeitos-e-inspecao.md"),
    (id: "gargalo", nome: "Gargalo",
     texto: "Recurso que limita a vazão do sistema. Um posto de inspeção lento pode virar o gargalo de uma linha que produzia bem.",
     manual: "resultados.md"),
    (id: "alarme_falso", nome: "Alarme falso",
     texto: "Peça boa rejeitada por engano. Aparece quando o instrumento de medição erra perto dos limites da especificação, e o resultado é refugo que não precisava existir.",
     manual: "defeitos-e-inspecao.md"),
    (id: "sistema_de_medicao", nome: "Sistema de medição",
     texto: "Instrumento, método e operador que juntos produzem uma medida. Todo sistema tem um erro, descrito aqui pelo desvio padrão da medição. Um desvio grande confunde peça boa com peça ruim.",
     manual: "qualidade.md"),
    (id: "quase_conflito", nome: "Quase-conflito simulado",
     texto: "Instante em que uma pessoa e um veículo ficam mais perto que um limite (1,5 m neste caso) na simulação. Serve para comparar layouts e regras de circulação. Não estima a probabilidade de um acidente real.",
     manual: "zonas-e-exposicao.md"),
    (id: "epi", nome: "EPI",
     texto: "Equipamento de proteção individual, como colete, luvas, óculos e protetor auricular. A simulação conta as entradas de uma pessoa numa zona de risco sem o equipamento que a zona pede.",
     manual: "zonas-e-exposicao.md"),
    (id: "zona_de_risco", nome: "Zona de risco",
     texto: "Área do piso com um perigo conhecido, como a circulação de empilhadeiras ou o ruído de uma prensa. Cada zona pode pedir equipamentos de proteção. O tempo e as entradas de cada pessoa na zona são medidos.",
     manual: "zonas-e-exposicao.md"),
    (id: "fadiga", nome: "Fadiga",
     texto: "Nível de cansaço de uma pessoa, de 0 a 1, que sobe com o trabalho e a carga e cai no descanso. Fadiga alta alonga os tempos e obriga a pausas. Dividir a carga entre pessoas reduz o pico de cada uma.",
     manual: "ergonomia.md"),
    (id: "rodizio", nome: "Rodízio",
     texto: "Troca das pessoas num posto pesado para que ninguém fique com toda a carga. No modelo, é a regra que distribui o trabalho em turnos entre os membros da equipe.",
     manual: "ergonomia.md"),
    (id: "custo_da_qualidade", nome: "Custo da qualidade",
     texto: "Soma do que se gasta para evitar defeitos (prevenção), para achá-los (avaliação, como a inspeção) e com as falhas, internas (refugo e retrabalho) e externas (o defeito que chega ao cliente). Prevenir costuma sair mais barato que consertar.",
     manual: "defeitos-e-inspecao.md"),
    (id: "prevencao", nome: "Prevenção",
     texto: "Gasto que reduz a probabilidade de o defeito nascer, como treinamento, dispositivo à prova de erro e manutenção do processo. No modelo, baixa a probabilidade do defeito no processo.",
     manual: "defeitos-e-inspecao.md"),
])
