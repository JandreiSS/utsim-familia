// Glossário vivo da campanha. Textos próprios do UTSim.
Glossario(termos: [
    (id: "gargalo", nome: "Gargalo",
     texto: "Recurso que limita a vazão do sistema. Costuma ser o de maior utilização, contando o tempo parado por quebra. Melhorar outro recurso quase não muda a vazão.",
     manual: "resultados.md"),
    (id: "utilizacao", nome: "Utilização",
     texto: "Fração do tempo em que o recurso trabalha. Numa estação com uma máquina, é o tempo médio de processo dividido pelo intervalo médio entre chegadas. Com c máquinas iguais, divide-se ainda por c.",
     manual: "resultados.md"),
    (id: "lead_time", nome: "Lead time (permanência)",
     texto: "Tempo que uma peça leva desde que entra até sair do sistema, somando filas, processos, setups e transportes.",
     manual: "resultados.md"),
    (id: "vazao", nome: "Vazão",
     texto: "Quantidade que sai do sistema por unidade de tempo (peças por hora, pedidos por semana). Num sistema estável, a vazão de longo prazo é igual à taxa de chegada, menos o que se perde.",
     manual: "resultados.md"),
    (id: "wip", nome: "Estoque em processo (WIP)",
     texto: "Quantidade de itens dentro do sistema num instante, em filas, máquinas e transportes. A média ao longo do tempo é a medida usada nas análises.",
     manual: "resultados.md"),
    (id: "lei_de_little", nome: "Lei de Little",
     texto: "Num sistema estável, o estoque médio em processo é igual à vazão multiplicada pelo lead time médio, com as unidades de tempo iguais. Vale para qualquer distribuição de chegadas e de tempos.",
     manual: "resultados.md"),
    (id: "gargalo_movel", nome: "Gargalo móvel",
     texto: "Quando quebras, turnos ou mudanças de mix fazem o recurso que limita a linha mudar ao longo do tempo. A análise por períodos mostra quem limitou em cada trecho.",
     manual: "resultados.md"),
    (id: "disponibilidade", nome: "Disponibilidade",
     texto: "Fração do tempo planejado em que a máquina está em condição de trabalhar, descontadas quebras e manutenções. É um dos três fatores do OEE.",
     manual: "manutencao.md"),
    (id: "fila", nome: "Fila",
     texto: "Itens esperando um recurso ocupado. A fila média cresce muito quando a utilização se aproxima de 1, e cresce mais quanto maior a variabilidade.",
     manual: "objetos.md"),
    (id: "custo_de_espera", nome: "Custo de espera",
     texto: "O que custa um item ou uma pessoa parada na fila (um mecânico sem ferramenta, um cliente esperando). O dimensionamento equilibra o custo do atendimento com o custo da espera."),
    (id: "perda_de_demanda", nome: "Perda de demanda",
     texto: "Clientes ou pedidos que vão embora porque não há lugar para esperar. A perda depende ao mesmo tempo da capacidade de atendimento e do espaço de espera."),
    (id: "bloqueio", nome: "Bloqueio",
     texto: "Estado de uma máquina que terminou o item mas não pode entregá-lo porque o lugar seguinte está cheio. Uma máquina bloqueada não produz, mesmo sem defeito.",
     manual: "objetos.md"),
    (id: "disciplina_de_fila", nome: "Disciplina de fila",
     texto: "Regra que escolhe o próximo item da fila: ordem de chegada, último a chegar, prioridade, prazo. A regra muda quem espera, não o total de trabalho do recurso.",
     manual: "objetos.md"),
    (id: "variabilidade", nome: "Variabilidade",
     texto: "Variação dos intervalos entre chegadas e dos tempos de processo em torno da média. Mesmo com médias iguais, mais variabilidade gera mais fila e mais estoque.",
     manual: "distribuicoes.md"),
    (id: "capacidade", nome: "Capacidade",
     texto: "Quanto um recurso ou uma linha consegue produzir por período, com o tempo disponível (turnos, quebras) e o tempo de processo. A capacidade da linha é a do gargalo."),
    (id: "turno", nome: "Turno",
     texto: "Período de trabalho de uma jornada. Mais turnos aumentam o tempo disponível das máquinas, com custo de pessoal e de adicional noturno.",
     manual: "quebras-e-turnos.md"),
    (id: "pulmao", nome: "Pulmão",
     texto: "Estoque intermediário entre duas estações. Absorve a variação dos tempos e as paradas, evitando bloqueio da anterior e falta de peças na seguinte."),
    (id: "manutencao_preventiva", nome: "Manutenção preventiva",
     texto: "Intervenção programada antes da quebra. Compensa quando a chance de falhar cresce com o uso e quando a preventiva é mais curta e barata que o reparo.",
     manual: "manutencao.md"),
    (id: "lote", nome: "Lote",
     texto: "Quantidade produzida de uma vez entre duas trocas de ferramenta. Lotes grandes diluem o setup e aumentam o lead time. Lotes pequenos fazem o contrário."),
    (id: "setup", nome: "Setup (troca de ferramenta)",
     texto: "Tempo para preparar a máquina para outro produto ou lote. A troca rápida passa parte da preparação para fora da máquina parada.",
     manual: "objetos.md"),
    (id: "takt", nome: "Takt",
     texto: "Ritmo da demanda: o tempo disponível dividido pela quantidade pedida. Uma linha que entrega no takt produz exatamente o que o cliente pede. Nenhuma estação pode ter mais trabalho que o takt.",
     manual: "ensino.md"),
    (id: "precedencia", nome: "Precedência",
     texto: "Ordem obrigatória entre tarefas de montagem: uma tarefa só pode ser feita depois das que a antecedem. Num balanceamento, nenhuma tarefa pode ficar numa estação anterior à de uma tarefa que precisa vir antes.",
     manual: "ensino.md"),
    (id: "eficiencia_de_balanceamento", nome: "Eficiência do balanceamento",
     texto: "Soma dos tempos das tarefas dividida pelo número de estações vezes o takt. O que falta para 1 é o atraso de balanceamento, o tempo ocioso das estações.",
     manual: "ensino.md"),
    (id: "arranjo_funcional", nome: "Arranjo funcional",
     texto: "Arranjo em que máquinas do mesmo tipo ficam juntas e cada família de peças percorre o seu roteiro pela fábrica. Serve a muitos produtos, com mais movimentação que o arranjo em linha ou celular.",
     manual: "ensino.md"),
    (id: "linha_de_modelos_mistos", nome: "Linha de modelos mistos",
     texto: "Linha que monta mais de um modelo do produto, intercalados. O balanceamento usa o tempo médio de cada tarefa, ponderado pelo mix, e a sequência de entrada evita que o modelo mais pesado passe do takt várias vezes seguidas.",
     manual: "ensino.md"),
    (id: "arranjo_celular", nome: "Arranjo celular",
     texto: "Arranjo em que as máquinas que uma família de peças usa ficam juntas, numa célula, mesmo que isso peça máquinas repetidas. A peça anda pouco e o lead time cai, ao custo das máquinas a mais.",
     manual: "ensino.md"),
    (id: "matriz_de_para", nome: "Matriz de-para",
     texto: "Tabela das viagens entre cada par de máquinas, somando o volume de todas as famílias que passam de uma para a outra. Mostra quais máquinas devem ficar perto.",
     manual: "fluxograma.md"),
    (id: "momento_de_transporte", nome: "Momento de transporte",
     texto: "Soma, sobre todos os pares de máquinas, das viagens vezes a distância. É a medida usada para comparar arranjos físicos.",
     manual: "ensino.md"),
    (id: "enderecamento_por_giro", nome: "Endereçamento por giro",
     texto: "Regra de armazenagem que põe os itens mais retirados nos endereços mais próximos da doca, reduzindo a distância total percorrida pelos separadores.",
     manual: "ensino.md"),
    (id: "movimentacao_interna", nome: "Movimentação interna",
     texto: "Transporte de materiais dentro da fábrica, por pessoas, empilhadeiras, esteiras ou AGVs. O tamanho da frota equilibra o custo dos veículos com a espera dos materiais.",
     manual: "recursos-moveis.md"),
    (id: "relacao_homem_maquina", nome: "Relação homem-máquina",
     texto: "Quantas máquinas um operador atende. Com a o tempo do operador com a máquina parada, b o tempo do operador longe dela (andando) e t o tempo automático, n linha = (a + t)/(a + b) máquinas não deixam máquina parada nem operador ocioso.",
     manual: "tempos-e-metodos.md"),
    (id: "ciclo", nome: "Ciclo",
     texto: "Tempo entre duas peças que saem do posto. No atendimento de várias máquinas, o ciclo é o maior entre o ciclo de uma máquina (a + t) e o tempo do operador para atender todas (n × (a + b)).",
     manual: "tempos-e-metodos.md"),
    (id: "custo_por_peca", nome: "Custo por peça",
     texto: "Custo por hora dos recursos dividido pelas peças produzidas por hora. Decide entre arranjos com mais ou menos máquinas por operador.",
     manual: "tempos-e-metodos.md"),
    (id: "trabalho_externo", nome: "Trabalho externo",
     texto: "Parte da preparação que pode ser feita com a máquina rodando (separar material, pré-ajustar ferramentas). Tirar trabalho da máquina parada encurta o ciclo quando as máquinas ditam o ritmo.",
     manual: "tempos-e-metodos.md"),
    (id: "tempo_padrao", nome: "Tempo padrão",
     texto: "Tempo para um operador qualificado fazer a tarefa em ritmo normal, com as tolerâncias para necessidades pessoais, fadiga e esperas. É o tempo normal (observado × ritmo) vezes um mais as tolerâncias.",
     manual: "tempos-e-metodos.md"),
    (id: "cronometragem", nome: "Cronometragem",
     texto: "Medição dos tempos de uma tarefa repetida, ciclo a ciclo. O número de ciclos depende da variação dos tempos e do erro aceito na média.",
     manual: "tempos-e-metodos.md"),
    (id: "retrabalho", nome: "Retrabalho",
     texto: "Peça reprovada que volta para ser corrigida e passa de novo pelas etapas. Aumenta a carga das estações repetidas e o lead time.",
     manual: "ensino.md"),
    (id: "modelagem", nome: "Modelagem",
     texto: "Tradução de um sistema real em objetos, ligações, tempos e regras de um modelo de simulação. O modelo é conferido comparando as medidas dele com as do sistema ou de um modelo de referência.",
     manual: "primeiros-passos.md"),
    (id: "dmaic", nome: "DMAIC",
     texto: "As cinco fases de um projeto Lean Seis Sigma: definir o problema e a meta, medir a situação atual, analisar as causas, melhorar com soluções testadas e controlar para o ganho não se perder.",
     manual: "seis-sigma.md"),
    (id: "ctq", nome: "CTQ (crítico para a qualidade)",
     texto: "Característica do produto ou do serviço que o cliente percebe e que o projeto mede, com especificação e meta.",
     manual: "seis-sigma.md"),
    (id: "msa", nome: "Análise do sistema de medição (R&R)",
     texto: "Estudo que separa a variação do instrumento (repetibilidade) e dos operadores (reprodutibilidade) da variação entre as peças. Abaixo de 10 % de R&R o sistema é aceitável, de 10 % a 30 % é marginal e acima de 30 % não serve.",
     manual: "qualidade.md"),
    (id: "capacidade_do_processo", nome: "Capacidade do processo",
     texto: "Quanto o processo cabe na especificação. O Ppk compara a distância da média ao limite mais próximo com três desvios padrão da variação total.",
     manual: "qualidade.md"),
    (id: "estratificacao", nome: "Estratificação",
     texto: "Separação dos dados por máquina, turno, operador ou lote para achar onde a variação ou o deslocamento está.",
     manual: "estatistica.md"),
    (id: "doe", nome: "Experimento fatorial",
     texto: "Ensaio que varia vários fatores ao mesmo tempo em níveis planejados. O efeito de um fator é a média da resposta no nível alto menos a média no nível baixo.",
     manual: "estatistica.md"),
    (id: "carta_de_controle", nome: "Carta de controle",
     texto: "Gráfico da medida ao longo do tempo com centro e limites calculados de um período estável. Regras como as de Nelson apontam causas especiais.",
     manual: "qualidade.md"),
])
