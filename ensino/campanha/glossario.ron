// Glossário vivo da campanha. Textos próprios do UTSim.
Glossario(termos: [
    (id: "gargalo", nome: "Gargalo",
     texto: "Recurso que limita a vazão do sistema. Costuma ser o de maior utilização, contando o tempo parado por quebra. Melhorar outro recurso quase não muda a vazão.",
     manual: "resultados.md"),
    (id: "utilizacao", nome: "Utilização",
     texto: "Fração do tempo em que o recurso trabalha. Numa estação com uma máquina, é o tempo médio de processo dividido pelo intervalo médio entre chegadas. Com c máquinas iguais, divide-se ainda por c.",
     manual: "resultados.md"),
    (id: "lead_time", nome: "Lead time (permanência)",
     texto: "Tempo que uma peça leva desde que entra até sair do sistema, somando filas, processos, setups e transportes.",
     manual: "resultados.md"),
    (id: "vazao", nome: "Vazão",
     texto: "Quantidade que sai do sistema por unidade de tempo (peças por hora, pedidos por semana). Num sistema estável, a vazão de longo prazo é igual à taxa de chegada, menos o que se perde.",
     manual: "resultados.md"),
    (id: "wip", nome: "Estoque em processo (WIP)",
     texto: "Quantidade de itens dentro do sistema num instante, em filas, máquinas e transportes. A média ao longo do tempo é a medida usada nas análises.",
     manual: "resultados.md"),
    (id: "lei_de_little", nome: "Lei de Little",
     texto: "Num sistema estável, o estoque médio em processo é igual à vazão multiplicada pelo lead time médio, com as unidades de tempo iguais. Vale para qualquer distribuição de chegadas e de tempos.",
     manual: "resultados.md"),
    (id: "gargalo_movel", nome: "Gargalo móvel",
     texto: "Quando quebras, turnos ou mudanças de mix fazem o recurso que limita a linha mudar ao longo do tempo. A análise por períodos mostra quem limitou em cada trecho.",
     manual: "resultados.md"),
    (id: "disponibilidade", nome: "Disponibilidade",
     texto: "Fração do tempo planejado em que a máquina está em condição de trabalhar, descontadas quebras e manutenções. É um dos três fatores do OEE.",
     manual: "manutencao.md"),
    (id: "fila", nome: "Fila",
     texto: "Itens esperando um recurso ocupado. A fila média cresce muito quando a utilização se aproxima de 1, e cresce mais quanto maior a variabilidade.",
     manual: "objetos.md"),
    (id: "custo_de_espera", nome: "Custo de espera",
     texto: "O que custa um item ou uma pessoa parada na fila (um mecânico sem ferramenta, um cliente esperando). O dimensionamento equilibra o custo do atendimento com o custo da espera."),
    (id: "perda_de_demanda", nome: "Perda de demanda",
     texto: "Clientes ou pedidos que vão embora porque não há lugar para esperar. A perda depende ao mesmo tempo da capacidade de atendimento e do espaço de espera."),
    (id: "bloqueio", nome: "Bloqueio",
     texto: "Estado de uma máquina que terminou o item mas não pode entregá-lo porque o lugar seguinte está cheio. Uma máquina bloqueada não produz, mesmo sem defeito.",
     manual: "objetos.md"),
    (id: "disciplina_de_fila", nome: "Disciplina de fila",
     texto: "Regra que escolhe o próximo item da fila: ordem de chegada, último a chegar, prioridade, prazo. A regra muda quem espera, não o total de trabalho do recurso.",
     manual: "objetos.md"),
    (id: "variabilidade", nome: "Variabilidade",
     texto: "Variação dos intervalos entre chegadas e dos tempos de processo em torno da média. Mesmo com médias iguais, mais variabilidade gera mais fila e mais estoque.",
     manual: "distribuicoes.md"),
    (id: "capacidade", nome: "Capacidade",
     texto: "Quanto um recurso ou uma linha consegue produzir por período, com o tempo disponível (turnos, quebras) e o tempo de processo. A capacidade da linha é a do gargalo."),
    (id: "turno", nome: "Turno",
     texto: "Período de trabalho de uma jornada. Mais turnos aumentam o tempo disponível das máquinas, com custo de pessoal e de adicional noturno.",
     manual: "quebras-e-turnos.md"),
    (id: "pulmao", nome: "Pulmão",
     texto: "Estoque intermediário entre duas estações. Absorve a variação dos tempos e as paradas, evitando bloqueio da anterior e falta de peças na seguinte."),
    (id: "manutencao_preventiva", nome: "Manutenção preventiva",
     texto: "Intervenção programada antes da quebra. Compensa quando a chance de falhar cresce com o uso e quando a preventiva é mais curta e barata que o reparo.",
     manual: "manutencao.md"),
    (id: "lote", nome: "Lote",
     texto: "Quantidade produzida de uma vez entre duas trocas de ferramenta. Lotes grandes diluem o setup e aumentam o lead time. Lotes pequenos fazem o contrário."),
    (id: "setup", nome: "Setup (troca de ferramenta)",
     texto: "Tempo para preparar a máquina para outro produto ou lote. A troca rápida passa parte da preparação para fora da máquina parada.",
     manual: "objetos.md"),
])
