            (rotulo: "Lotes de 10", ajustes: {"chegada.table": "(mode: Sequence, repeat: Loop, rows: [(labels: {\"modelo\": 1.0}), (labels: {\"modelo\": 1.0}), (labels: {\"modelo\": 1.0}), (labels: {\"modelo\": 1.0}), (labels: {\"modelo\": 1.0}), (labels: {\"modelo\": 1.0}), (labels: {\"modelo\": 1.0}), (labels: {\"modelo\": 1.0}), (labels: {\"modelo\": 1.0}), (labels: {\"modelo\": 1.0}), (labels: {\"modelo\": 2.0}), (labels: {\"modelo\": 2.0}), (labels: {\"modelo\": 2.0}), (labels: {\"modelo\": 2.0}), (labels: {\"modelo\": 2.0}), (labels: {\"modelo\": 2.0}), (labels: {\"modelo\": 2.0}), (labels: {\"modelo\": 2.0}), (labels: {\"modelo\": 2.0}), (labels: {\"modelo\": 2.0})])"}, numero: 10),
            (rotulo: "Alternado (mesa, coluna, mesa...)", ajustes: {"chegada.table": "(mode: Sequence, repeat: Loop, rows: [(labels: {\"modelo\": 1.0}), (labels: {\"modelo\": 2.0})])"}, numero: 1),
        ]),
    ],
    metricas: [
        (nome: "mesa", rotulo: "Ventiladores de mesa por hora (simulado)", unidade: "un/h",
         valor: [(chave: "saida_mesa.input", fator: 0.125)], objetivo: Maior, meta: 29.5, peso: 0.0,
         tolerancia: Absoluta(0.2), casas: 1),
        (nome: "coluna", rotulo: "Ventiladores de coluna por hora (simulado)", unidade: "un/h",
         valor: [(chave: "saida_coluna.input", fator: 0.125)], objetivo: Maior, meta: 29.5, peso: 0.0,
         tolerancia: Absoluta(0.2), casas: 1),
        (nome: "estacoes", rotulo: "Estações usadas", unidade: "",
         valor: [(chave: "balanceamento.estacoes")], objetivo: Menor, peso: 1.0, casas: 0),
        (nome: "pico", rotulo: "Maior carga de um modelo numa estação", unidade: "s",
         valor: [(chave: "balanceamento.pico")], objetivo: Menor, peso: 0.5, casas: 0),
        (nome: "lote", rotulo: "Ventiladores de um modelo antes de trocar", unidade: "",
         valor: [(chave: "decisao.sequencia")], objetivo: Maior, peso: 0.5, casas: 0),
    ],
    justificativa: [
        (pergunta: "Por que a sequência dos modelos muda a vazão de uma linha balanceada pela média?",
         opcoes: ["Porque num lote do modelo mais pesado a estação passa do takt várias vezes seguidas, e o pulmão pequeno não segura", "Porque cada troca de modelo exige um setup demorado", "Porque o takt muda conforme o modelo"],
         certa: 0),
    ],
    dicas: [
        "Olhe a carga de cada modelo em cada estação, não só a média. Qual estação passa do takt no modelo de coluna?",
        "Uma estação pode passar do takt num modelo se ficar abaixo no outro, desde que eles se alternem.",
        "Junte tarefas pesadas no modelo de coluna com tarefas pesadas no de mesa. Depois escolha o maior lote que ainda alcança a meta dos dois modelos.",
    ],
    referencia: {"sequencia": 1, "tarefa.A": 1, "tarefa.B": 1, "tarefa.C": 2, "tarefa.D": 2, "tarefa.E": 3, "tarefa.F": 3, "tarefa.G": 4, "tarefa.H": 4, "tarefa.I": 5, "tarefa.J": 6, "tarefa.K": 6, "tarefa.L": 7, "tarefa.M": 7, "tarefa.N": 8},
