Missao(
    id: "ato4/mix",
    titulo: "Mudou o mix",
    conceitos: ["linha_de_modelos_mistos", "takt", "eficiencia_de_balanceamento"],
    modelo: "../modelos/ventilador_mix.ron",
    texto: "mix.md",
    previsao: [
        Escolha(
            id: "lotes",
            pergunta: "Com o mesmo balanceamento, montar em lotes de 40 de cada modelo entrega tanto quanto alternar mesa e coluna, um a um?",
            opcoes: [
                (rotulo: "Sim, porque na média cada estação cabe no takt", valor: [(chave: "saida_mesa.input", fator: 0.125), (chave: "saida_coluna.input", fator: 0.125)]),
                (rotulo: "Não, em lotes a linha entrega menos", valor: [(chave: "const", fator: 59.5)]),
            ],
            resposta: Maior,
        ),
    ],
    balanceamento: (
        takt: 60.0,
        estacoes: 10,
        mix: [
            (id: "mesa", nome: "Mesa", parcela: 1.0),
            (id: "coluna", nome: "Coluna", parcela: 1.0),
        ],
        tarefas: [
            (id: "A", nome: "Fixar a base na bancada", tempo: 20.0, tempos: {"mesa": 15.0, "coluna": 25.0}),
            (id: "B", nome: "Montar a haste", tempo: 25.0, depois_de: ["A"], tempos: {"mesa": 10.0, "coluna": 40.0}),
            (id: "C", nome: "Fixar o motor na haste", tempo: 40.0, depois_de: ["B"], tempos: {"mesa": 40.0, "coluna": 40.0}),
            (id: "D", nome: "Passar o cabo pela haste", tempo: 15.0, depois_de: ["C"], tempos: {"mesa": 10.0, "coluna": 20.0}),
            (id: "E", nome: "Montar a grade traseira", tempo: 30.0, depois_de: ["C"], tempos: {"mesa": 30.0, "coluna": 30.0}),
            (id: "F", nome: "Instalar a hélice", tempo: 20.0, depois_de: ["E"], tempos: {"mesa": 20.0, "coluna": 20.0}),
            (id: "G", nome: "Montar a grade frontal", tempo: 25.0, depois_de: ["F"], tempos: {"mesa": 25.0, "coluna": 25.0}),
            (id: "H", nome: "Fixar os botões na base", tempo: 20.0, depois_de: ["A"], tempos: {"mesa": 30.0, "coluna": 10.0}),
            (id: "I", nome: "Ligar o painel de botões", tempo: 30.0, depois_de: ["D", "H"], tempos: {"mesa": 30.0, "coluna": 30.0}),
            (id: "J", nome: "Montar a carcaça do motor", tempo: 35.0, depois_de: ["I"], tempos: {"mesa": 45.0, "coluna": 25.0}),
            (id: "K", nome: "Fixar a carcaça", tempo: 25.0, depois_de: ["J"], tempos: {"mesa": 20.0, "coluna": 30.0}),
            (id: "L", nome: "Colar a etiqueta", tempo: 10.0, depois_de: ["K"], tempos: {"mesa": 10.0, "coluna": 10.0}),
            (id: "M", nome: "Testar o funcionamento", tempo: 45.0, depois_de: ["G", "K"], tempos: {"mesa": 40.0, "coluna": 50.0}),
            (id: "N", nome: "Embalar", tempo: 30.0, depois_de: ["L", "M"], tempos: {"mesa": 25.0, "coluna": 35.0}),
        ],
        inicial: {"A": 1, "B": 1, "C": 2, "H": 2, "D": 3, "I": 3, "E": 4, "F": 4, "J": 5, "K": 5, "G": 6, "L": 6, "M": 7, "N": 8},
    ),
