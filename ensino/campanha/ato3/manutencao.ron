            (rotulo: "Preventiva a cada 150 min de uso", ajustes: {"torno.downtime": "(mtbf: Exp(mean: 600.0), mttr: Triangular(min: 30.0, mode: 45.0, max: 90.0), wear: Weibull(shape: 3.0, scale: 500.0), basis: Busy, repair: AsGoodAsNew, preventive: [(every: Hours(150.0), duration: Const(20.0))], cost: (per_time_down: 8.0, per_repair: 400.0, per_preventive: 80.0), oee: ())"}),
