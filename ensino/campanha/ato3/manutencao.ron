            (rotulo: "Preventiva a cada 150 min de uso e kit de reparo rápido", ajustes: {"torno.downtime": "(mtbf: Exp(mean: 600.0), mttr: Triangular(min: 15.0, mode: 20.0, max: 40.0), wear: Weibull(shape: 3.0, scale: 500.0), basis: Busy, repair: AsGoodAsNew, preventive: [(every: Hours(150.0), duration: Const(20.0))], cost: (per_time_down: 8.0, per_repair: 400.0, per_preventive: 80.0), oee: ())"}, custo: 2000),
            (rotulo: "Preventiva a cada 250 min de uso e kit de reparo rápido", ajustes: {"torno.downtime": "(mtbf: Exp(mean: 600.0), mttr: Triangular(min: 15.0, mode: 20.0, max: 40.0), wear: Weibull(shape: 3.0, scale: 500.0), basis: Busy, repair: AsGoodAsNew, preventive: [(every: Hours(250.0), duration: Const(20.0))], cost: (per_time_down: 8.0, per_repair: 400.0, per_preventive: 80.0), oee: ())"}, custo: 2000),
            (rotulo: "Preventiva a cada 400 min de uso e kit de reparo rápido", ajustes: {"torno.downtime": "(mtbf: Exp(mean: 600.0), mttr: Triangular(min: 15.0, mode: 20.0, max: 40.0), wear: Weibull(shape: 3.0, scale: 500.0), basis: Busy, repair: AsGoodAsNew, preventive: [(every: Hours(400.0), duration: Const(20.0))], cost: (per_time_down: 8.0, per_repair: 400.0, per_preventive: 80.0), oee: ())"}, custo: 2000),
        ]),
