         objetivo: Menor, meta: 112.0, casas: 0),
        (nome: "perda", rotulo: "Fração de clientes perdidos", unidade: "",
         valor: [(chave: "model.loss_fraction")], objetivo: Menor, meta: 0.05, peso: 0.0, casas: 3),
    ],
    justificativa: [
        (pergunta: "Mais lugares na sala resolvem a perda quando o guichê está quase sempre ocupado?",
