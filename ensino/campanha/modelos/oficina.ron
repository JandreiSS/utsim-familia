// Oficina de usinagem
// Cada fluxo é uma cadeia própria: o objeto <maquina>__<fluxo> fica na posição da máquina
// no arranjo escolhido. As peças andam em linha reta entre as máquinas a 60 m/min, então
// a matriz de-para da rodada mostra as distâncias do arranjo. Tempo em minutos.
Model(
    name: "Oficina de usinagem",
    run: (stop_time: 4800.0, warmup: 480.0, seed: 51, replications: 10, transfer: Some((speed: 60.0))),
    objects: [
        (name: "doca__eixos_chegada", kind: Source(interarrival: Exp(mean: 12.000))),
        (name: "serra__eixos_1", kind: Processor(capacity: 4, process: Exp(mean: 2.0))),
        (name: "torno__eixos_2", kind: Processor(capacity: 4, process: Exp(mean: 2.0))),
        (name: "retifica__eixos_3", kind: Processor(capacity: 4, process: Exp(mean: 2.0))),
        (name: "inspecao__eixos_4", kind: Processor(capacity: 4, process: Exp(mean: 2.0))),
        (name: "doca__eixos_fim", kind: Sink),
        (name: "doca__flanges_chegada", kind: Source(interarrival: Exp(mean: 16.000))),
        (name: "serra__flanges_1", kind: Processor(capacity: 4, process: Exp(mean: 2.0))),
        (name: "torno__flanges_2", kind: Processor(capacity: 4, process: Exp(mean: 2.0))),
        (name: "furadeira__flanges_3", kind: Processor(capacity: 4, process: Exp(mean: 2.0))),
        (name: "inspecao__flanges_4", kind: Processor(capacity: 4, process: Exp(mean: 2.0))),
        (name: "doca__flanges_fim", kind: Sink),
        (name: "doca__suportes_chegada", kind: Source(interarrival: Exp(mean: 19.200))),
        (name: "serra__suportes_1", kind: Processor(capacity: 4, process: Exp(mean: 2.0))),
        (name: "fresa__suportes_2", kind: Processor(capacity: 4, process: Exp(mean: 2.0))),
        (name: "furadeira__suportes_3", kind: Processor(capacity: 4, process: Exp(mean: 2.0))),
        (name: "inspecao__suportes_4", kind: Processor(capacity: 4, process: Exp(mean: 2.0))),
        (name: "doca__suportes_fim", kind: Sink),
        (name: "doca__buchas_chegada", kind: Source(interarrival: Exp(mean: 24.000))),
        (name: "torno__buchas_1", kind: Processor(capacity: 4, process: Exp(mean: 2.0))),
        (name: "retifica__buchas_2", kind: Processor(capacity: 4, process: Exp(mean: 2.0))),
        (name: "inspecao__buchas_3", kind: Processor(capacity: 4, process: Exp(mean: 2.0))),
        (name: "doca__buchas_fim", kind: Sink),
        (name: "doca__placas_chegada", kind: Source(interarrival: Exp(mean: 32.000))),
        (name: "fresa__placas_1", kind: Processor(capacity: 4, process: Exp(mean: 2.0))),
        (name: "furadeira__placas_2", kind: Processor(capacity: 4, process: Exp(mean: 2.0))),
        (name: "doca__placas_fim", kind: Sink),
    ],
    connections: [
        ("doca__eixos_chegada", "serra__eixos_1"),
        ("serra__eixos_1", "torno__eixos_2"),
        ("torno__eixos_2", "retifica__eixos_3"),
        ("retifica__eixos_3", "inspecao__eixos_4"),
        ("inspecao__eixos_4", "doca__eixos_fim"),
        ("doca__flanges_chegada", "serra__flanges_1"),
        ("serra__flanges_1", "torno__flanges_2"),
        ("torno__flanges_2", "furadeira__flanges_3"),
        ("furadeira__flanges_3", "inspecao__flanges_4"),
        ("inspecao__flanges_4", "doca__flanges_fim"),
        ("doca__suportes_chegada", "serra__suportes_1"),
        ("serra__suportes_1", "fresa__suportes_2"),
        ("fresa__suportes_2", "furadeira__suportes_3"),
        ("furadeira__suportes_3", "inspecao__suportes_4"),
        ("inspecao__suportes_4", "doca__suportes_fim"),
        ("doca__buchas_chegada", "torno__buchas_1"),
        ("torno__buchas_1", "retifica__buchas_2"),
        ("retifica__buchas_2", "inspecao__buchas_3"),
        ("inspecao__buchas_3", "doca__buchas_fim"),
        ("doca__placas_chegada", "fresa__placas_1"),
        ("fresa__placas_1", "furadeira__placas_2"),
        ("furadeira__placas_2", "doca__placas_fim"),
    ],
)
