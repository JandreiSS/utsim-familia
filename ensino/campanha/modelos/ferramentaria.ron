// Missão 2.1: balcão da ferramentaria. Mecânicos chegam para retirar ferramentas. Tempo em minutos.
Model(
    name: "Balcão da ferramentaria",
    run: (stop_time: 20500.0, warmup: 500.0, seed: 21, replications: 10),
    objects: [
        (name: "mecanicos", kind: Source(interarrival: Exp(mean: 4.0)), position: (0.0, 0.0, 0.0)),
        (name: "fila",      kind: Queue(),                              position: (4.0, 0.0, 0.0)),
        (name: "balcao",    kind: Processor(capacity: 1, process: Exp(mean: 3.5)), position: (8.0, 0.0, 0.0)),
        (name: "oficina",   kind: Sink,                                 position: (12.0, 0.0, 0.0)),
    ],
    connections: [("mecanicos", "fila"), ("fila", "balcao"), ("balcao", "oficina")],
)
