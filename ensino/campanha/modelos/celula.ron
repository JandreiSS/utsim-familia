// Missão 6.3: célula de três máquinas cuja preparação precisa de um operador da equipe.
// Tempo em segundos. Os operadores fora da equipe ficam parados.
Model(
    name: "Célula com equipe de preparação",
    run: (stop_time: 100000.0, warmup: 2000.0, seed: 63, replications: 10),
    objects: [
        (name: "chegada", kind: Source(interarrival: Exp(mean: 40.0)), position: (0.0, 5.0, 0.0)),
        (name: "fila", kind: Queue(), position: (5.0, 5.0, 0.0)),
        (name: "maq1", kind: Processor(setup: Exp(mean: 25.0), process: Exp(mean: 80.0),
            operators: OperatorUse(team: "equipe", count: 1, setup: true, process: false)), position: (15.0, 0.0, 0.0)),
        (name: "maq2", kind: Processor(setup: Exp(mean: 25.0), process: Exp(mean: 80.0),
            operators: OperatorUse(team: "equipe", count: 1, setup: true, process: false)), position: (15.0, 5.0, 0.0)),
        (name: "maq3", kind: Processor(setup: Exp(mean: 25.0), process: Exp(mean: 80.0),
            operators: OperatorUse(team: "equipe", count: 1, setup: true, process: false)), position: (15.0, 10.0, 0.0)),
        (name: "saida", kind: Sink, position: (25.0, 5.0, 0.0)),
        (name: "ana", kind: Transporter(speed: 1.2), position: (10.0, 2.0, 0.0), visual: (asset: "pessoa")),
        (name: "bruno", kind: Transporter(speed: 1.2), position: (10.0, 8.0, 0.0), visual: (asset: "pessoa")),
        (name: "carla", kind: Transporter(speed: 1.2), position: (10.0, 5.0, 0.0), visual: (asset: "pessoa")),
        (name: "equipe", kind: Dispatcher(team: ["ana"]), position: (10.0, 5.0, 0.0)),
    ],
    connections: [
        ("chegada", "fila"), ("fila", "maq1"), ("fila", "maq2"), ("fila", "maq3"),
        ("maq1", "saida"), ("maq2", "saida"), ("maq3", "saida"),
    ],
)
