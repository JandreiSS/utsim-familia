// Missão 1.4: duas máquinas, a primeira mais rápida mas com quebras longas. Tempo em minutos.
Model(
    name: "Prensa e dobradeira",
    run: (stop_time: 20500.0, warmup: 500.0, seed: 17, replications: 10),
    objects: [
        (name: "chegada",        kind: Source(interarrival: Exp(mean: 3.0)), position: (0.0, 0.0, 0.0)),
        (name: "fila_prensa",    kind: Queue(),                              position: (4.0, 0.0, 0.0)),
        (name: "prensa",         kind: Processor(process: Exp(mean: 1.9)),   position: (8.0, 0.0, 0.0),
         downtime: (mtbf: Exp(mean: 150.0), mttr: Exp(mean: 45.0))),
        (name: "fila_dobradeira", kind: Queue(),                             position: (12.0, 0.0, 0.0)),
        (name: "dobradeira",     kind: Processor(process: Exp(mean: 2.4)),   position: (16.0, 0.0, 0.0)),
        (name: "saida",          kind: Sink,                                 position: (20.0, 0.0, 0.0)),
    ],
    connections: [
        ("chegada", "fila_prensa"), ("fila_prensa", "prensa"), ("prensa", "fila_dobradeira"),
        ("fila_dobradeira", "dobradeira"), ("dobradeira", "saida"),
    ],
)
