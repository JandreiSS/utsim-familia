// Missão 7.2: gabarito da padaria industrial. Tempo em minutos.
Model(
    name: "Padaria industrial",
    run: (stop_time: 10560.0, warmup: 480.0, seed: 72, replications: 10),
    objects: [
        (name: "massas", kind: Source(interarrival: Exp(mean: 6.0)), position: (0.0, 0.0, 0.0)),
        (name: "fila_divisora", kind: Queue(), position: (4.0, 0.0, 0.0)),
        (name: "divisora", kind: Processor(process: Triangular(min: 3.0, mode: 4.0, max: 5.5)), position: (8.0, 0.0, 0.0)),
        (name: "camara", kind: Processor(capacity: 10, process: Const(45.0)), position: (12.0, 0.0, 0.0)),
        (name: "fila_forno", kind: Queue(), position: (16.0, 0.0, 0.0)),
        (name: "forno", kind: Processor(capacity: 2, process: Triangular(min: 10.0, mode: 12.0, max: 16.0)),
         downtime: (mtbf: Exp(mean: 300.0), mttr: Exp(mean: 20.0)), position: (20.0, 0.0, 0.0)),
        (name: "fila_embalagem", kind: Queue(), position: (24.0, 0.0, 0.0)),
        (name: "embalagem", kind: Processor(process: Uniform(min: 4.0, max: 6.0)), position: (28.0, 0.0, 0.0)),
        (name: "expedicao", kind: Sink, position: (32.0, 0.0, 0.0)),
    ],
    connections: [
        ("massas", "fila_divisora"), ("fila_divisora", "divisora"), ("divisora", "camara"),
        ("camara", "fila_forno"), ("fila_forno", "forno"), ("forno", "fila_embalagem"),
        ("fila_embalagem", "embalagem"), ("embalagem", "expedicao"),
    ],
)
