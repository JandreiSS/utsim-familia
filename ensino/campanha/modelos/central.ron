// Missão 2.5: central de atendimento com sala de espera. Tempo em minutos.
Model(
    name: "Central de atendimento",
    run: (stop_time: 10600.0, warmup: 600.0, seed: 25, replications: 10),
    objects: [
        (name: "chamadas",    kind: Source(interarrival: Exp(mean: 1.0), on_blocked: Drop), position: (0.0, 0.0, 0.0)),
        (name: "espera",      kind: Queue(capacity: 6),                                     position: (4.0, 0.0, 0.0)),
        (name: "atendentes",  kind: Processor(capacity: 3, process: Gamma(shape: 2.0, scale: 1.5)), position: (8.0, 0.0, 0.0)),
        (name: "encerradas",  kind: Sink,                                                   position: (12.0, 0.0, 0.0)),
    ],
    connections: [("chamadas", "espera"), ("espera", "atendentes"), ("atendentes", "encerradas")],
)
