// Armazém de peças de reposição
// Cada fluxo é uma cadeia própria: o objeto <maquina>__<fluxo> fica na posição da máquina
// no arranjo escolhido. As peças andam em linha reta entre as máquinas a 60 m/min, então
// a matriz de-para da rodada mostra as distâncias do arranjo. Tempo em minutos.
Model(
    name: "Armazém de peças de reposição",
    run: (stop_time: 4800.0, warmup: 480.0, seed: 51, replications: 10, transfer: Some((speed: 60.0))),
    objects: [
        (name: "doca__a_chegada", kind: Source(interarrival: Exp(mean: 40.000))),
        (name: "item_a__a_1", kind: Processor(capacity: 4, process: Const(0.5))),
        (name: "doca__a_fim", kind: Sink),
        (name: "doca__b_chegada", kind: Source(interarrival: Exp(mean: 10.667))),
        (name: "item_b__b_1", kind: Processor(capacity: 4, process: Const(0.5))),
        (name: "doca__b_fim", kind: Sink),
        (name: "doca__c_chegada", kind: Source(interarrival: Exp(mean: 60.000))),
        (name: "item_c__c_1", kind: Processor(capacity: 4, process: Const(0.5))),
        (name: "doca__c_fim", kind: Sink),
        (name: "doca__d_chegada", kind: Source(interarrival: Exp(mean: 16.000))),
        (name: "item_d__d_1", kind: Processor(capacity: 4, process: Const(0.5))),
        (name: "doca__d_fim", kind: Sink),
        (name: "doca__e_chegada", kind: Source(interarrival: Exp(mean: 8.000))),
        (name: "item_e__e_1", kind: Processor(capacity: 4, process: Const(0.5))),
        (name: "doca__e_fim", kind: Sink),
        (name: "doca__f_chegada", kind: Source(interarrival: Exp(mean: 96.000))),
        (name: "item_f__f_1", kind: Processor(capacity: 4, process: Const(0.5))),
        (name: "doca__f_fim", kind: Sink),
        (name: "doca__g_chegada", kind: Source(interarrival: Exp(mean: 24.000))),
        (name: "item_g__g_1", kind: Processor(capacity: 4, process: Const(0.5))),
        (name: "doca__g_fim", kind: Sink),
        (name: "doca__h_chegada", kind: Source(interarrival: Exp(mean: 32.000))),
        (name: "item_h__h_1", kind: Processor(capacity: 4, process: Const(0.5))),
        (name: "doca__h_fim", kind: Sink),
    ],
    connections: [
        ("doca__a_chegada", "item_a__a_1"),
        ("item_a__a_1", "doca__a_fim"),
        ("doca__b_chegada", "item_b__b_1"),
        ("item_b__b_1", "doca__b_fim"),
        ("doca__c_chegada", "item_c__c_1"),
        ("item_c__c_1", "doca__c_fim"),
        ("doca__d_chegada", "item_d__d_1"),
        ("item_d__d_1", "doca__d_fim"),
        ("doca__e_chegada", "item_e__e_1"),
        ("item_e__e_1", "doca__e_fim"),
        ("doca__f_chegada", "item_f__f_1"),
        ("item_f__f_1", "doca__f_fim"),
        ("doca__g_chegada", "item_g__g_1"),
        ("item_g__g_1", "doca__g_fim"),
        ("doca__h_chegada", "item_h__h_1"),
        ("item_h__h_1", "doca__h_fim"),
    ],
)
