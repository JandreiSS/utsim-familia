// Campanha do UTSim Ensino: atos 1 a 8 (gargalo e fluxo, filas, capacidade, balanceamento,
// arranjo físico, tempos e métodos, problemas integrados e o caso Lean Seis Sigma).
Pacote(
    id: "campanha",
    formato: 1,
    titulo: "Campanha UTSim Ensino",
    versao: "0.6.0",
    autor: "UTSim",
    descricao: "Do gargalo ao modelo: decisões numa fábrica simulada, com previsão, alavancas, peças para montar e modelos para entregar, e nota pela simulação.",
    requer: ["nucleo >= 0.1"],
    glossario: "glossario.ron",
    // Conceito do glossário para ferramentas do currículo do UTSim Seis Sigma: a missão
    // resolvida vira "praticou" nessas ferramentas no programa da empresa.
    competencias: {
        "ctq": ["voc_ctq"],
        "msa": ["msa"],
        "capacidade_do_processo": ["capacidade"],
        "doe": ["doe"],
        "carta_de_controle": ["cep"],
        "lead_time": ["vsm"],
        "wip": ["vsm"],
        "takt": ["vsm"],
    },
    atos: [
        (numero: 1, titulo: "Gargalo e fluxo", missoes: [
            "ato1/furadeira.ron",
            "ato1/lugar_errado.ron",
            "ato1/little.ron",
            "ato1/gargalo_que_muda.ron",
        ]),
        (numero: 2, titulo: "Filas e atendimento", missoes: [
            "ato2/ferramentaria.ron",
            "ato2/desistencia.ron",
            "ato2/urgente.ron",
            "ato2/variabilidade.ron",
            "ato2/central.ron",
        ]),
        (numero: 3, titulo: "Capacidade, turnos e estoque intermediário", missoes: [
            "ato3/turnos.ron",
            "ato3/pulmao.ron",
            "ato3/manutencao.ron",
            "ato3/lote.ron",
            "ato3/expansao.ron",
        ]),
        (numero: 4, titulo: "Balanceamento de linha", missoes: [
            "ato4/ventilador.ron",
            "ato4/variabilidade.ron",
            "ato4/demanda_nova.ron",
        ]),
        (numero: 5, titulo: "Arranjo físico e movimentação", missoes: [
            "ato5/oficina.ron",
            "ato5/armazem.ron",
            "ato5/frota.ron",
        ]),
        (numero: 6, titulo: "Tempos e métodos", missoes: [
            "ato6/maquinas_por_operador.ron",
            "ato6/trabalho_externo.ron",
            "ato6/celula.ron",
            "ato6/cronometragem.ron",
        ]),
        (numero: 7, titulo: "Problemas integrados", missoes: [
            "ato7/linha_retrabalho.ron",
            "ato7/clinica.ron",
            "ato7/reembolso.ron",
            "ato7/padaria.ron",
        ]),
        (numero: 8, titulo: "O caso Lean Seis Sigma", missoes: [
            "ato8/definir.ron",
            "ato8/medir.ron",
            "ato8/analisar.ron",
            "ato8/melhorar.ron",
            "ato8/controlar.ron",
        ]),
    ],
)
