Missao(
    id: "ato8/controlar",
    titulo: "Controlar: a deriva da noite",
    conceitos: ["carta_de_controle", "dmaic"],
    modelo: "../modelos/eixos.ron",
    texto: "controlar.md",
    dados: [
        (id: "acompanhamento", nome: "Diâmetro de um eixo por hora depois da melhoria (mm)",
         gerador: Serie(n: 80, media: 25.0, sd: 0.004, padrao: Deslocamento(inicio: 52, tamanho: 2.0))),
    ],
    previsao: [
        Escolha(
            id: "carta",
            pergunta: "Qual carta usar para uma medida por hora?",
            opcoes: [(rotulo: "Carta de valores individuais e amplitude móvel (I-AM)"), (rotulo: "Carta de média e amplitude com subgrupos de 5"), (rotulo: "Carta p")],
            resposta: Fixa(0),
        ),
        Dados(id: "sinal", pergunta: "Com os limites calculados pelos 30 primeiros pontos e as regras de Nelson, em qual ponto aparece o primeiro sinal?",
              conjunto: "acompanhamento", questao: PrimeiroSinal(base: 30), unidade: "", tolerancia: Absoluta(0.0)),
    ],
    justificativa: [
        (pergunta: "O que o plano de reação deve dizer quando a carta dá sinal?",
         opcoes: ["Quem para a máquina, quem verifica a ferramenta e o que fazer com as peças do período", "Que se deve recalcular os limites", "Que basta anotar e seguir"],
         certa: 0),
    ],
    animacao: (duracao: 480, unidade: "min"),
    cena: (
        imagem: "eixos.cena.png",
        escala: 0.8,
        elementos: {"torno": "cnc", "retifica": "cnc", "acabamento": "posto", "inspecao": "posto"},
        pecas: [
            (no: "barras", elemento: "peca", dx: -0.35),
            (no: "barras", elemento: "peca", dx: 0.35),
            (no: "fila_torno", elemento: "peca", dx: -0.35),
            (no: "fila_torno", elemento: "peca", dx: 0.35),
            (no: "fila_retifica", elemento: "peca", dx: -0.35),
            (no: "fila_retifica", elemento: "peca", dx: 0.35),
            (no: "fila_acabamento", elemento: "peca", dx: -0.7),
            (no: "fila_acabamento", elemento: "peca"),
            (no: "fila_acabamento", elemento: "peca", dx: 0.7),
            (no: "fila_inspecao", elemento: "peca"),
            (no: "expedicao", elemento: "caixa"),
            (no: "refugo", elemento: "caixa", cor: "#d63031"),
        ],
        cartoes: [
            (no: "retifica", tipo: Texto("Um eixo por hora vai para a carta de controle")),
            (no: "retifica@pe", tipo: Previsao("carta")),
        ],
    ),
)
